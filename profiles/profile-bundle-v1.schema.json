{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MultiTimer reusable profile bundle v1",
  "description": "Structural constraints only; the format document also requires byte, lexical and ordered-offset checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "profiles"
  ],
  "properties": {
    "format": {
      "const": "com.ose.multitimer.profiles"
    },
    "version": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mode",
        "beepDurationMillis",
        "periodMillis",
        "events",
        "beepOnCue",
        "beepOnCompletion",
        "speakOnCompletion",
        "speakCurrentTime",
        "speakElapsedTime",
        "speakRemainingTime",
        "speakOnCue",
        "speakClockNameWithSpeech"
      ],
      "properties": {
        "name": {
          "type": "string",
        "minLength": 1
        },
        "mode": {
          "enum": [
            "PERIODIC",
            "SCRIPTED"
          ]
        },
        "beepDurationMillis": {
          "type": "integer",
          "minimum": 50,
          "maximum": 10000
        },
        "periodMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "events": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/cue"
          }
        },
        "beepOnCue": {
          "type": "boolean"
        },
        "beepOnCompletion": {
          "type": "boolean"
        },
        "speakOnCompletion": {
          "type": "boolean"
        },
        "speakCurrentTime": {
          "type": "boolean"
        },
        "speakElapsedTime": {
          "type": "boolean"
        },
        "speakRemainingTime": {
          "type": "boolean"
        },
        "speakOnCue": {
          "type": "boolean"
        },
        "speakClockNameWithSpeech": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "PERIODIC"
              }
            }
          },
          "then": {
            "properties": {
              "periodMillis": {
                "minimum": 1
              },
              "events": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "periodMillis": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offsetMillis",
        "speechText",
        "beepDurationMillis"
      ],
      "properties": {
        "offsetMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "speechText": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "beepDurationMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "anyOf": [
        {
          "properties": {
            "speechText": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "beepDurationMillis": {
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
